# Copy to .env and fill in. .env is git-ignored.
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AKS_RESOURCE_GROUP=rg-nequi-disputes-demo
AKS_CLUSTER_NAME=aks-nequi-disputes
AZURE_LOCATION=eastus2
AKS_NODE_COUNT=2
AKS_NODE_VM_SIZE=Standard_D2s_v6
K8S_NAMESPACE=disputes
ACR_NAME=acrnequidisputes
KEYVAULT_NAME=kv-nequi-disputes
AOAI_NAME=aoai-nequi-disputes
AOAI_DEPLOYMENT=gpt-4o
AOAI_MODEL=gpt-4o
AOAI_MODEL_VERSION=2024-11-20
AOAI_CAPACITY_K_TPM=30
AOAI_API_VERSION=2024-10-21
JWT_ISSUER=https://idp.nequi.demo
JWT_AUDIENCE=dispute-triage
JWT_PUBLIC_KEY_FILE=.local/jwt-public.pem
CORE_SYSTEMS_URL=http://127.0.0.1:8001
FRAUD_AGENT_URL=http://127.0.0.1:8002
LEDGER_AGENT_URL=http://127.0.0.1:8003
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
INTERNAL_JWT_ISSUER=https://supervisor.disputes.internal
INTERNAL_JWT_AUDIENCE=dispute-agents
INTERNAL_JWT_PRIVATE_KEY_FILE=.local/internal-jwt-private.pem
INTERNAL_JWT_PUBLIC_KEY_FILE=.local/internal-jwt-public.pem
SERVICEBUS_NAMESPACE=sb-nequi-disputes
SERVICEBUS_QUEUE=disputes
REFUNDS_QUEUE=refunds

# Public demo UI (ADR-0024): http://<label>.<region>.cloudapp.azure.com
DEMO_UI_DNS_LABEL=nequi-disputes-demo
